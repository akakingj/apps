{
  "id": "cluster_redline",
  "title": "Cluster Redline",
  "description": "Independent stock/Redline cluster and HUD outputs, adjustable placement and native-guidance priority",
  "version": "1.0.2",
  "vendor": "custom",
  "loggingId": "OAC7",
  "iconGlyph": "rpm",
  "mguAppStartType": "autostart",
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusFESVehicleDynamicSwitchHMI": "rs",
      "statusActualValueTorque2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "_optional": "current gear display; RPM and shift alerts still work without it",
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infotainment.misc.MDrive": {
      "_optional": "S/M programme; regular gear, RPM and shift alerts work without it",
      "dataDisplayGearbox": "s"
    },
    "de.bmw.infotainment.navigation.guiding.Guidance": {
      "_optional": "Read-only native navigation state; HUD stays released when guidance state cannot be checked",
      "guidanceState": "r",
      "_instances": "Main_Instance"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Cluster Redline",
      "buttons": [
        [
          "BTN_BASIC",
          "Basic settings"
