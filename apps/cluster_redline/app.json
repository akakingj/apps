{
  "id": "cluster_redline",
  "title": "Cluster Redline",
  "description": "Tabbed cluster settings, vehicle presets, true power/torque unit conversion and Sport/all-mode display",
  "version": "0.8.5",
  "vendor": "custom",
  "loggingId": "OAC7",
  "iconGlyph": "rpm",
  "mguAppStartType": "autostart",
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusFESVehicleDynamicSwitchHMI": "rs",
      "statusActualValueTorque2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "_optional": "current gear display; RPM and shift alerts still work without it",
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infotainment.misc.MDrive": {
      "_optional": "S/M programme; regular gear, RPM and shift alerts work without it",
      "dataDisplayGearbox": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Cluster Redline",
      "buttons": [
        [
          "BTN_BASIC",
          "Basic settings"
        ],
        [
          "BTN_ADVANCED",
          "Advanced settings"
        ],
        [
          "BTN_PREVIOUS",
          "Previous item"
        ],
        [
          "BTN_NEXT",
          "Next item"
        ],
        [
          "BTN_VALUE_DOWN",
          "Value -"
        ],
        [
          "BTN_VALUE_UP",
          "Value +"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "appEnabled",
      "label": "App auto start",
      "type": "bool",
      "default": true
    },
    {
      "key": "engineProfile",
      "label": "Vehicle preset",
      "type": "choice",
      "default": "petrol",
      "options": [
        [
          "petrol",
          "Petrol"
        ],
        [
          "diesel",
          "Diesel"
        ],
        [
          "hybrid",
          "eDrive (PHEV)"
        ],
        [
          "m",
          "M"
        ]
      ]
    },
    {
      "key": "displayMode",
      "label": "Display mode",
      "type": "choice",
      "default": "sport",
      "options": [
        [
          "sport",
          "Sport modes only"
        ],
        [
          "all",
          "All drive modes"
        ]
      ]
    },
    {
      "key": "powerUnit",
      "label": "Power unit",
      "type": "choice",
      "default": "PS",
      "options": [
        [
          "PS",
          "PS"
        ],
        [
          "kW",
          "kW"
        ]
      ]
    },
    {
      "key": "torqueUnit",
      "label": "Torque unit",
      "type": "choice",
      "default": "Nm",
      "options": [
        [
          "Nm",
          "Nm"
        ],
        [
          "kgfm",
          "kgf·m"
        ]
      ]
    },
    {
      "key": "shiftRpm",
      "label": "Shift alert RPM",
      "type": "number",
      "unit": "rpm",
      "default": 0,
      "labels": {
        "0": "Preset default"
      },
      "steps": [
        0,
        2000,
        2500,
        3000,
        3500,
        4000,
        4200,
        4500,
        4700,
        5000,
        5500,
        5800,
        6000,
        6200,
        6500,
        6800,
        7000,
        7500
      ]
    },
    {
      "key": "displayTarget",
      "label": "Display layer",
      "type": "choice",
      "default": "panel",
      "options": [
        [
          "panel",
          "Front center (test)"
        ],
        [
          "map",
          "Map area (legacy)"
        ]
      ]
    },
    {
      "key": "widgetScale",
      "label": "Widget size",
      "type": "number",
      "unit": "%",
      "default": 80,
      "steps": [
        60,
        65,
        70,
        75,
        80,
        85,
        90,
        100
      ]
    },
    {
      "key": "renderer",
      "label": "Renderer",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "Automatic"
        ]
      ],
      "hidden": true
    }
  ],
  "mguClusterRenderMinVersion": "0.3.10",
  "mguLocalOnly": true
}
